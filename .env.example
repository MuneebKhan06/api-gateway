# Copy to .env and adjust for your machine.

ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

ROUTES_FILE=routes.yaml

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# Generate a real one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

DEFAULT_RATE_LIMIT_ALGORITHM=token_bucket
DEFAULT_RATE_LIMIT_REQUESTS=100
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60

BREAKER_FAILURE_THRESHOLD=5
BREAKER_FAILURE_WINDOW_SECONDS=60
BREAKER_RECOVERY_TIMEOUT_SECONDS=30
BREAKER_SUCCESS_THRESHOLD=2

UPSTREAM_TIMEOUT_SECONDS=30
