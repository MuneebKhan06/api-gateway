FROM python:3.11-slim AS base

# Bytecode files and stdout buffering are both unhelpful in a container:
# the first bloats the image, the second hides logs when the process dies.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Requirements are copied on their own so the dependency layer stays cached
# when only application code changes.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY gateway/ ./gateway/
COPY routes.yaml ./routes.yaml

# Running as root inside a container is an unnecessary risk.
RUN useradd --create-home --uid 1000 gateway && chown -R gateway:gateway /app
USER gateway

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
