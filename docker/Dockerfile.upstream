# One image for all three mock upstreams. Which service it runs is decided at
# runtime by SERVICE_MODULE, so there is a single image to build and cache
# rather than three near-identical ones.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# The mock services only need the web framework, not the gateway's Redis and
# database dependencies.
RUN pip install --no-cache-dir fastapi==0.115.0 "uvicorn[standard]==0.32.0"

COPY upstream/ ./upstream/

RUN useradd --create-home --uid 1000 upstream && chown -R upstream:upstream /app
USER upstream

ENV SERVICE_MODULE=upstream.service_a.main:app \
    SERVICE_PORT=8001

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://localhost:'+os.environ['SERVICE_PORT']+'/health')"

CMD ["sh", "-c", "uvicorn $SERVICE_MODULE --host 0.0.0.0 --port $SERVICE_PORT"]
